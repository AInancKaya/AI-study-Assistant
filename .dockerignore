# Keep the build context small and free of local state and secrets.
.git
.gitignore
.github
.superpowers
.venv
data
evals
tests
docs
scripts
Makefile
.pre-commit-config.yaml
.python-version
Dockerfile
docker-compose.yml
.dockerignore

# Python caches and coverage output
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
coverage.xml
htmlcov
dist
build
*.egg-info

# Secrets and local env files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
