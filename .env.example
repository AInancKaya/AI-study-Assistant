# Copy to .env and edit. Every setting is optional; defaults live in src/study_assistant/config.py.
# No API keys are needed: the LLM runs locally through Ollama.
STUDY_OLLAMA_HOST=http://localhost:11434
STUDY_LLM_MODEL=gemma2:9b
STUDY_LLM_TIMEOUT_S=180
STUDY_EMBEDDING_MODEL=intfloat/multilingual-e5-small
STUDY_DATA_DIR=data
STUDY_CHUNK_SIZE=1500
STUDY_CHUNK_OVERLAP=200
STUDY_TOP_K=6
STUDY_MIN_SCORE=0.75
STUDY_QUIZ_MAX_CHUNKS=10
STUDY_MAX_UPLOAD_MB=50
STUDY_MAX_PAGES=300
STUDY_API_URL=http://localhost:8000
